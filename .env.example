# Required. Bot token from the Discord Developer Portal, under Bot.
# The bot will refuse to start without this. Never commit a real token here -
# this file is meant to be checked into git as a template; real values go in
# your local .env only (which is gitignored).
DISCORD_TOKEN=

# Prefix for text commands, e.g. "!kick". Slash commands work regardless of this.
# Safe to leave as "!"; do not leave this blank (an empty prefix matches every message).
COMMAND_PREFIX=!

# Comma-separated Discord user IDs that bypass role-hierarchy checks on mod commands.
# Optional - leave blank and only server permissions (Manage Server etc) apply.
OWNER_IDS=

# Optional, dev-only. Your home server's ID (right-click the server icon with
# Developer Mode on, Copy Server ID). Commands always sync globally regardless
# (so the bot works in every server it's invited to), which can take up to an
# hour to show up after the command set changes. Setting GUILD_ID additionally
# syncs an instant copy to this one server too, so you see changes right away
# while developing locally. Leave blank in production - it's not required for
# the bot to work in any server, including this one.
GUILD_ID=

# Where the SQLite database file is created. Safe to leave as-is.
DB_PATH=data/bot.db

# AI chatbot. Set to "openai", "xai", or leave blank to disable the chatbot
# feature entirely (no crash either way - the cog just won't load).
AI_PROVIDER=

# Only needed if AI_PROVIDER=openai. Get a key from platform.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Only needed if AI_PROVIDER=xai. Get a key from console.x.ai.
XAI_API_KEY=
XAI_MODEL=grok-4

# How many past messages (combined user+bot) to keep as context per channel.
AI_HISTORY_LENGTH=10
# Max tokens the model can generate per reply.
AI_MAX_TOKENS=600

# Enables the /search command via the Tavily API (tavily.com - free tier, no card required).
# Leave blank to disable /search entirely - no crash, the cog just won't load.
TAVILY_API_KEY=

# Optional bot-level image moderation for explicit content, on top of Discord's
# own built-in Explicit Media Content Filter (turn that on separately in
# Server Settings > Safety Setup - it's the real backstop and works regardless
# of this setting). Set to "sightengine", "hive", or leave blank to disable.
# Even when set here, it's off per-server until you also run /automod images true.
IMAGE_MOD_PROVIDER=

# Only needed if IMAGE_MOD_PROVIDER=sightengine. Get credentials from sightengine.com.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Only needed if IMAGE_MOD_PROVIDER=hive. Get a key from thehive.ai.
HIVE_API_KEY=

# 0.0-1.0. Higher = only flags more clearly explicit images; lower = stricter/more false positives.
IMAGE_MOD_NUDITY_THRESHOLD=0.6

# General automod tuning. All have safe built-in defaults, so these can be left
# blank if you don't want to think about them.
# Messages get deleted as "mass mention" once they contain this many mentions.
AUTOMOD_MAX_MENTIONS=6
# A user posting this many messages within AUTOMOD_SPAM_INTERVAL_SECS gets flagged as spam.
AUTOMOD_SPAM_MSG_COUNT=5
AUTOMOD_SPAM_INTERVAL_SECS=5

# A user who racks up this many automod warnings (any kind, combined) within
# AUTOMOD_WARN_WINDOW_SECS gets timed out for AUTOMOD_TIMEOUT_MINUTES instead of
# just getting another warning. Requires the bot to have Timeout Members.
AUTOMOD_WARN_THRESHOLD=3
AUTOMOD_WARN_WINDOW_SECS=600
AUTOMOD_TIMEOUT_MINUTES=10

# Music playback. Requires ffmpeg installed separately (not a pip package) and
# on PATH - on the droplet: apt install ffmpeg. Also needs the PyNaCl and
# yt-dlp pip packages from requirements.txt; if either ffmpeg or PyNaCl is
# missing, the cog just won't load (no crash).
# Path/name of the ffmpeg executable. Safe to leave as "ffmpeg" if it's on PATH.
FFMPEG_PATH=ffmpeg
# Max tracks held in a single guild's queue at once.
MUSIC_MAX_QUEUE=200
# Max tracks pulled in from one playlist link in a single /play.
MUSIC_MAX_PLAYLIST_SIZE=25
# Default volume percent (0-200) for newly started playback.
MUSIC_DEFAULT_VOLUME=100
# Auto-disconnect after this many seconds with an empty queue, or alone in the channel.
MUSIC_IDLE_TIMEOUT_SECS=300

# Python logging level: DEBUG, INFO, WARNING, ERROR. Safe to leave as INFO.
LOG_LEVEL=INFO
